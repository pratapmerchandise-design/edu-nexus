# ==========================================
# EDU NEXUS - MYSQL WORKBENCH CONFIGURATION
# ==========================================
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=edu_nexus

# JWT Auth Secret
JWT_SECRET_KEY=your_jwt_secret_key

# ==========================================
# EDU NEXUS - EMAIL (SMTP) CONFIGURATION
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=Edu Nexus <your_email@gmail.com>
FRONTEND_BASE=http://localhost:5173

# ==========================================
# EDU NEXUS - RAZORPAY PAYMENT GATEWAY
# ==========================================
# When ready to accept live payments, paste your Razorpay Key ID and Secret below:
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
